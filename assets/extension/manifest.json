{
  "manifest_version": 3,
  "name": "Hotline",
  "version": "0.11.0",
  "description": "Passkeys the teammate is granted, answered by this computer: the keys never enter the browser.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "webAuthenticationProxy",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "conditional.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Hotline",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
